{
  "name": "hivo-configs",
  "version": "1.0.0",
  "description": "HiVo Configs — Intelligent Telegram Config Engine. Monitors source channels, detects and extracts proxy configs (VLESS/VMess/Trojan/Shadowsocks/SSR), validates, deduplicates, GeoIP-tags and republishes them one-by-one to destination channels.",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "migrate": "node dist/database/migrate.js"
  },
  "dependencies": {
    "telegram": "^2.22.2",
    "grammy": "^1.24.1",
    "better-sqlite3": "^11.3.0",
    "maxmind": "^4.3.20",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.19.0",
    "@types/node": "^20.14.15",
    "@types/better-sqlite3": "^7.6.11"
  }
}
